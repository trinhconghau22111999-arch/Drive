<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Giữ CPU/Wi-Fi hoạt động và hiện thông báo khi đang tải lên -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 7–9 cần quyền này để DownloadManager lưu vào thư mục Download -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="Drive 3 Hồ Sơ"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:hardwareAccelerated="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Mỗi hồ sơ chạy trong 1 process riêng => cookie/đăng nhập tách biệt hoàn toàn -->
        <activity
            android:name=".PhotoActivity"
            android:process=":p1"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout" />
        <activity
            android:name=".VideoActivity"
            android:process=":p2"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout" />
        <activity
            android:name=".FileActivity"
            android:process=":p3"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout" />

        <!-- Android < 9: 3 hồ sơ chạy CHUNG process chính (không có android:process), vì máy cũ
             không tách được thư mục dữ liệu WebView theo process. Đăng nhập được tách bằng cách đổi
             cookie theo hồ sơ (xem DriveCookies.java). -->
        <activity
            android:name=".LegacyPhotoActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout" />
        <activity
            android:name=".LegacyVideoActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout" />
        <activity
            android:name=".LegacyFileActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout" />

        <!-- Dịch vụ nền giữ tải lên: phải cùng process với trang Drive thì process đó mới khó bị hệ thống tắt -->
        <service
            android:name=".UploadService$P1"
            android:process=":p1"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".UploadService$P2"
            android:process=":p2"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".UploadService$P3"
            android:process=":p3"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- Cho các hồ sơ Legacy (chạy trong process chính) -->
        <service
            android:name=".UploadService$L"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
